# Copie para .env (cp .env.example .env) e preencha. O .env NÃO vai para o git.

# Django
SECRET_KEY=troque-por-uma-chave-longa-e-secreta
DEBUG=1                      # em produção: 0
ALLOWED_HOSTS=               # em produção: dominio.com,outro.com

# MongoDB Atlas (dados das fontes: chuva, maré, dengue, referência)
MONGO_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/
MONGO_BANCO=Recife

# PostgreSQL (Neon): usuários, alertas e ações. Vazio = SQLite local (db.sqlite3)
DATABASE_URL=

# ETL
ETL_DESTINO=mongo

# Só para a carga histórica de maré (Copernicus CDS)
CDSAPI_KEY=
